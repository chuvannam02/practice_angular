# syntax=docker/dockerfile:1

# Override with image@sha256:... in CI to pin the exact base image.
ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=cgr.dev/chainguard/nginx:latest

FROM ${NODE_IMAGE} AS manifests
WORKDIR /app
ENV NG_CLI_ANALYTICS=false \
    npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=120000
COPY package.json package-lock.json ./

# Optional target for learning about Node/SSR production dependencies.
# BuildKit skips this unused branch when building the final static nginx image.
FROM manifests AS production-deps
RUN --mount=type=cache,id=practice-angular-npm,target=/root/.npm,sharing=locked \
    npm ci --omit=dev --prefer-offline --no-audit --no-fund

FROM manifests AS build-deps
# Angular CLI, TypeScript and the application builder are devDependencies.
RUN --mount=type=cache,id=practice-angular-npm,target=/root/.npm,sharing=locked \
    npm ci --include=dev --prefer-offline --no-audit --no-fund

FROM build-deps AS build
COPY angular.json tsconfig.json tsconfig.app.json ./
COPY src/ ./src/
COPY public/ ./public/
RUN npm run build -- --configuration production

# No shell, npm, source tree or node_modules in the final image.
FROM ${NGINX_IMAGE} AS runtime
# Dedicated named identity. Content/config stay root-owned and readable by app.
COPY --chmod=0644 docker/passwd /etc/passwd
COPY --chmod=0644 docker/group /etc/group
COPY --chmod=0644 docker/nginx-advanced.conf /etc/nginx/nginx.conf
COPY --from=build --chown=0:0 /app/dist/practice_angular/browser/ /usr/share/nginx/html/
USER 10001:10001
EXPOSE 8080
STOPSIGNAL SIGQUIT
# Distroless has no /bin/sh; always use exec form.
ENTRYPOINT ["/usr/sbin/nginx", "-e", "/dev/stderr"]
CMD ["-g", "daemon off;"]
